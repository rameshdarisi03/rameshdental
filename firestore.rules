rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper check: is user authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper check: retrieve user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 1. Appointments Collection
    match /appointments/{appointmentId} {
      allow read: if true; // Required for patients to check slot availability
      allow create: if true; // Patients can book
      allow update, delete: if isSignedIn();
    }

    // 2. Blocks Collection
    match /blocks/{blockId} {
      allow read: if true; // Patients see closed slots
      allow write: if isSignedIn();
    }

    // 3. Settings Collection
    match /settings/{settingId} {
      allow read: if true; // Patients see durations/shifts
      allow write: if isSignedIn() && getUserRole() == 'admin';
    }

    // 4. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getUserRole() == 'admin';
    }

    // 5. Patients Collection & Sub-collections
    match /patients/{patientId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 6. Exercise Library Collection
    match /exercise_library/{exerciseId} {
      allow read, write: if true;
    }

    // 7. Prescriptions Collection
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    // 8. Exercise Progress Tracking Collection
    match /exercise_progress/{patientId} {
      allow read, write: if true;
    }

    // 9. Invoices Collection (MODULAR_INVOICING)
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }
  }
}
