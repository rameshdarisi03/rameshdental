rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    // Check if the request is from a logged-in user
    function isSignedIn() {
      return request.auth != null;
    }

    // Get the logged in user's email address
    function userEmail() {
      return request.auth != null && request.auth.token.email != null 
        ? request.auth.token.email 
        : "";
    }

    // Check if the user is authenticated clinic staff / doctor
    // Resilient multi-tier verification:
    // 1. Has active profile in /users/{uid}
    // 2. Or has staff role in custom auth claims
    // 3. Or email domain belongs to official clinic domain (@rameshdental.com)
    // 4. Or matches authorized clinic administrator emails
    function isStaff() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (request.auth.token.role != null && request.auth.token.role in ['admin', 'receptionist', 'staff', 'doctor']) ||
        (userEmail().matches('(?i).*@rameshdental\\.(com|in)$')) ||
        userEmail().matches('(?i)admin@rameshdental\\.com') ||
        userEmail().matches('(?i)receptionist@rameshdental\\.com') ||
        userEmail().matches('(?i)rameshdarisi01@gmail\\.com') ||
        userEmail().matches('(?i)rameshdheer\\.sai@gmail\\.com')
      );
    }

    // Check if the logged-in user belongs to this Family Circle
    // (Matches authUid, legacy userId, primary email, email in linkedEmails, phone claim, or direct patientId)
    function isFamilyCircleMember(patientData) {
      return isSignedIn() && (
        (request.auth.uid != null && "authUid" in patientData && patientData.authUid == request.auth.uid) ||
        (request.auth.uid != null && "userId" in patientData && patientData.userId == request.auth.uid) ||
        (userEmail() != "" && "email" in patientData && patientData.email.matches('(?i)' + userEmail())) ||
        (userEmail() != "" && "linkedEmails" in patientData && userEmail() in patientData.linkedEmails) ||
        (request.auth.token.phone != null && "phone" in patientData && patientData.phone.matches('.*' + request.auth.token.phone + '.*'))
      );
    }

    // =========================================================================
    // 1. APPOINTMENTS COLLECTION
    // =========================================================================
    // Public visitors can view available slots and book appointments online
    // Clinic staff can manage, confirm, and update all appointments
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // 2. BLOCKS COLLECTION (Calendar Doctor Availability)
    // =========================================================================
    // Public booking calendar needs to read blocked times
    match /blocks/{blockId} {
      allow read: if true;
      allow write, delete: if isStaff();
    }

    // =========================================================================
    // 3. SETTINGS COLLECTION (Clinic Info, Timings, Consultation Fees)
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write, delete: if isStaff();
    }

    // =========================================================================
    // 4. USERS COLLECTION (Staff & Doctor Accounts)
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      allow delete: if isStaff();
    }

    // =========================================================================
    // 5. PATIENTS COLLECTION & FAMILY CIRCLE
    // =========================================================================
    match /patients/{patientId} {
      // Clinic staff, signed-in users, or verified patient/family member can view record
      allow read: if isStaff() || isSignedIn() || isFamilyCircleMember(resource.data) || (request.auth != null && request.auth.uid == patientId);

      // Staff and registered users can manage and update records
      allow create: if isStaff() || isSignedIn();
      allow update: if isStaff() || isSignedIn() || isFamilyCircleMember(resource.data) || (request.auth != null && request.auth.uid == patientId);
      allow delete: if isStaff();

      // Sub-collections: files (scans/PDFs), consultations (clinical notes), prescription history
      match /{allSubcollections=**} {
        allow read: if isStaff() || isSignedIn();
        allow write, delete: if isStaff() || isSignedIn();
      }
    }

    // =========================================================================
    // 6. EXERCISE LIBRARY COLLECTION
    // =========================================================================
    match /exercise_library/{exerciseId} {
      allow read: if true;
      allow write, delete: if isStaff();
    }

    // =========================================================================
    // 7. ACTIVE PRESCRIPTIONS
    // =========================================================================
    match /prescriptions/{prescriptionId} {
      // Allow read for staff or authenticated patient streaming assigned exercises
      allow read: if isStaff() || isSignedIn();
      allow write, delete: if isStaff();
    }

    // =========================================================================
    // 8. EXERCISE WORKOUT TRACKING (Daily Patient Progress)
    // =========================================================================
    match /exercise_progress/{patientId} {
      allow read, write, delete: if isStaff() || (
        isSignedIn() && (
          request.auth.uid != null ||
          isFamilyCircleMember(get(/databases/$(database)/documents/patients/$(patientId)).data)
        )
      );
    }

    // =========================================================================
    // 9. INVOICES COLLECTION
    // =========================================================================
    match /invoices/{invoiceId} {
      // Staff and signed-in members can access invoices; patients can view invoices issued to them
      allow read: if isStaff() || isSignedIn() || (
        userEmail() != "" && "patientEmail" in resource.data && resource.data.patientEmail.matches('(?i)' + userEmail())
      );
      allow write, delete: if isStaff() || isSignedIn();
    }

    // =========================================================================
    // 10. EMAIL LOGS COLLECTION (Audit Trail)
    // =========================================================================
    match /email_logs/{logId} {
      allow read, write, delete: if isStaff() || isSignedIn();
    }

    // =========================================================================
    // 11. RECOVERY STORIES COLLECTION (Video Showcase & Case Studies)
    // =========================================================================
    match /recovery_stories/{storyId} {
      // Public visitors can stream patient recovery video cases
      allow read: if true;
      // All admins, receptionists, and clinic staff can create, update, or remove stories
      allow write, delete: if isStaff() || isSignedIn();
    }
  }
}
